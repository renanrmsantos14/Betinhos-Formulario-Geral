# Copie para .env.local e preencha apenas no computador local.
DEEPSEEK_API_KEY=
# Opcional: Responses API com Structured Output.
DEEPSEEK_API_URL=https://api.deepseek.com/responses

# Push Power Platform DEV. Preencha uma vez depois de criar as refs na solução.
# Nunca commite .env.local.
AI_SCHEDULE_DATAVERSE_CONNECTION_REFERENCE=
AI_SCHEDULE_DEEPSEEK_CONNECTION_REFERENCE=
# Só preencha se o connector já existir e o PAC exigir atualização por ID.
AI_SCHEDULE_DEEPSEEK_CONNECTOR_ID=
